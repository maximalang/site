{
  "name": "@agent-world/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && npm run prepare:standalone",
    "dev": "next dev",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:runtime:isolated": "node scripts/verify-runtime-isolated.mjs",
    "typecheck": "next typegen && tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@agent-world/conversation-service": "0.0.0",
    "@agent-world/domain": "0.0.0",
    "@agent-world/model-gateway": "0.0.0",
    "@agent-world/openclaw-adapter": "0.0.0",
    "@agent-world/postgres-store": "0.0.0",
    "@agent-world/read-model": "0.0.0",
    "next": "16.3.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/pg": "8.21.0",
    "jsdom": "30.0.1"
  }
}
