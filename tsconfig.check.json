{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": {
      "@agent-world/codex-adapter": ["./packages/codex-adapter/src/index.ts"],
      "@agent-world/conversation-service": ["./packages/conversation-service/src/index.ts"],
      "@agent-world/domain": ["./packages/domain/src/index.ts"],
      "@agent-world/graphiti-adapter": ["./packages/graphiti-adapter/src/index.ts"],
      "@agent-world/model-gateway": ["./packages/model-gateway/src/index.ts"],
      "@agent-world/openclaw-adapter": ["./packages/openclaw-adapter/src/index.ts"],
      "@agent-world/postgres-store": ["./packages/postgres-store/src/index.ts"],
      "@agent-world/read-model": ["./packages/read-model/src/index.ts"],
      "@agent-world/scheduler": ["./packages/scheduler/src/index.ts"]
    },
    "sourceMap": false
  },
  "include": [
    "apps/codex-worker/src/**/*.ts",
    "apps/native-chat-launcher/src/**/*.ts",
    "packages/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/orchestration/**/*"]
}
