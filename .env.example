# Docker Compose uses one URL-safe random PostgreSQL password for the private
# data network. Generate at least 32 random bytes; do not reuse it elsewhere.
AGENT_WORLD_POSTGRES_PASSWORD=replace-with-32-random-bytes-base64url
AGENT_WORLD_SITE_ADDRESS=https://agent-world.example.com
# Optional host port overrides for an isolated local verification.
# AGENT_WORLD_HTTP_PORT=8080
# AGENT_WORLD_HTTPS_PORT=8443

# Direct-process development can instead provide its own PostgreSQL URL.
DATABASE_URL=postgresql://agent_world:replace-me@127.0.0.1:5432/agent_world
AGENT_WORLD_DATABASE_TLS=disable
# Required only for plaintext PostgreSQL on an explicitly private non-loopback network.
# AGENT_WORLD_DATABASE_PLAINTEXT_ACK=private-network

# Generate these offline; never put plaintext passwords in this file.
AGENT_WORLD_OWNER_PASSWORD_HASH='scrypt-v1$32768$8$1$replace-salt$replace-digest'
AGENT_WORLD_CSRF_SECRET=replace-with-32-random-bytes-base64url
# Generate exactly 32 random bytes and encode them as unpadded base64url.
AGENT_WORLD_SECRET_MASTER_KEY=replace-with-32-random-bytes-base64url
AGENT_WORLD_SECRET_KEY_VERSION=1
AGENT_WORLD_LITELLM_MASTER_KEY=replace-with-32-random-bytes-base64url
AGENT_WORLD_LITELLM_SALT_KEY=replace-with-32-random-bytes-base64url

# Host Git root mounted read-write into the private Codex worker. The default
# is this repository. Use a dedicated root; symlink escapes and non-Git roots
# are rejected before the official SDK starts.
# AGENT_WORLD_CODEX_PROJECT_ROOT=C:/path/to/selected/repository
# AGENT_WORLD_CODEX_WORKER_ID=codex-worker-1
# Canonical Account created in Hub; the worker will activate only this exact ID.
# AGENT_WORLD_CODEX_ACCOUNT_ID=account_00000000-0000-0000-0000-000000000000
# AGENT_WORLD_CODEX_LEASE_MS=60000
# AGENT_WORLD_CODEX_POLL_MS=2000

# Optional until OpenClaw is configured. Use wss:// off-loopback.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=replace-me
# Use exactly one credential kind.
# OPENCLAW_GATEWAY_DEVICE_TOKEN=replace-me
# AGENT_WORLD_INSTANCE_ID=agent-world

# Native Plus Chat MCP remains fail-closed until all three values are set.
# The resource must be the exact public HTTPS endpoint and JWT audience.
# Reused wrapper code still requires a dedicated AI World hostname, OAuth
# issuer, signing/cookie keys, database and process. Never reuse another
# product's audience, token family, routes, secrets or storage.
# AGENT_WORLD_MCP_ENABLED=true
# AGENT_WORLD_MCP_RESOURCE=https://agent-world.example.com/api/mcp
# AGENT_WORLD_MCP_OAUTH_ISSUER=https://agent-world.example.com/oauth
# Enable the Compose profile only after generating both persistent files.
# The JWK file contains a private ES256 P-256 signing key; permissions should
# allow only the deployment owner to read it. Cookie keys is a JSON array of
# at least two independent 32-byte base64url values.
# AGENT_WORLD_MCP_AUTH_PROVIDER=local_oidc
# AGENT_WORLD_MCP_OAUTH_JWKS_FILE=C:/secure/agent-world-oauth-jwks.json
# AGENT_WORLD_MCP_OAUTH_COOKIE_KEYS_FILE=C:/secure/agent-world-oauth-cookie-keys.json
# Bootstrap once into an existing absolute directory outside this repository:
# npm.cmd run bootstrap:secrets --workspace @agent-world/native-chat-auth -- C:\secure\agent-world-native-chat
# Start as the isolated AI World Compose project:
# docker compose -p agent-world --profile native-chat up -d

# Native Plus Chat browser launcher runs on the owner's laptop, outside Docker.
# Use a dedicated absolute profile root; log in to each account manually in its
# own profile. Never copy cookies or browser credentials into AI World.
# AGENT_WORLD_NATIVE_CHAT_LAUNCHER_ID=launcher_00000000-0000-0000-0000-000000000000
# AGENT_WORLD_NATIVE_CHAT_PROFILE_ROOT=C:/secure/agent-world-chat-profiles
# AGENT_WORLD_NATIVE_CHAT_LEASE_MS=120000
# AGENT_WORLD_NATIVE_CHAT_POLL_MS=2000
# AGENT_WORLD_NATIVE_CHAT_PAGE_RETENTION_MS=1800000
# AGENT_WORLD_NATIVE_CHAT_ONCE=false
# Optional startup registration; set all three values together. The URL must
# open the AI World GPT/App that calls the MCP run tools after receiving run_id.
# AGENT_WORLD_NATIVE_CHAT_ACCOUNT_ID=account_00000000-0000-0000-0000-000000000000
# AGENT_WORLD_NATIVE_CHAT_PROFILE_REF=plus-primary
# AGENT_WORLD_NATIVE_CHAT_LAUNCH_URL=https://chatgpt.com/g/replace-with-ai-world-gpt

# Optional rebuildable Graphiti/FalkorDB memory projection. Keep this service
# private; the adapter rejects credential-bearing URLs and stale add_memory schemas.
# AGENT_WORLD_GRAPHITI_MCP_URL=http://graphiti:8000/mcp/
# AGENT_WORLD_GRAPHITI_PLAINTEXT_ACK=private-network
# AGENT_WORLD_GRAPHITI_MODEL=gpt-5-mini
# AGENT_WORLD_GRAPHITI_EMBEDDER_MODEL=text-embedding-3-small
# AGENT_WORLD_GRAPHITI_EMBEDDER_DIMENSIONS=1536
# AGENT_WORLD_GRAPHITI_CONCURRENCY=2
# AGENT_WORLD_GRAPHITI_POLL_MS=5000
# AGENT_WORLD_MISSION_HANDOFF_POLL_MS=5000

# Optional read-only Observatory projection to Langfuse's pinned OTLP/HTTP
# endpoint. PostgreSQL remains authoritative and Langfuse failure is fail-open.
# Only aggregate run/token/context/cost/route counts are exported; prompts,
# outputs, result summaries, route IDs and credentials are intentionally omitted.
# AGENT_WORLD_LANGFUSE_BASE_URL=https://langfuse.example.com
# AGENT_WORLD_LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
# AGENT_WORLD_LANGFUSE_SECRET_KEY=sk-lf-replace-me
# AGENT_WORLD_LANGFUSE_POLL_MS=30000
# AGENT_WORLD_LANGFUSE_TIMEOUT_MS=5000
# Required only for http:// on a deliberately private network.
# AGENT_WORLD_LANGFUSE_PLAINTEXT_ACK=private-network

# Exact hostnames that the owner may probe from the Integration registry.
# No host is reachable by default. Keep this list narrow and comma-separated.
# AGENT_WORLD_INTEGRATION_ALLOWED_HOSTS=mcp.example.com,n8n.example.com,api.github.com,vds.example.com
# Required only when an allowlisted host resolves to loopback/private/link-local space.
# AGENT_WORLD_INTEGRATION_PRIVATE_NETWORK_ACK=private-network
# Start with: docker compose --profile graph-memory up -d --build
