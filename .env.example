# Docker Compose uses one URL-safe random PostgreSQL password for the private
# data network. Generate at least 32 random bytes; do not reuse it elsewhere.
AGENT_WORLD_POSTGRES_PASSWORD=replace-with-32-random-bytes-base64url
AGENT_WORLD_SITE_ADDRESS=https://agent-world.example.com
# Optional host port overrides for an isolated local verification.
# AGENT_WORLD_HTTP_PORT=8080
# AGENT_WORLD_HTTPS_PORT=8443

# Direct-process development can instead provide its own PostgreSQL URL.
DATABASE_URL=postgresql://agent_world:replace-me@127.0.0.1:5432/agent_world
AGENT_WORLD_DATABASE_TLS=disable
# Required only for plaintext PostgreSQL on an explicitly private non-loopback network.
# AGENT_WORLD_DATABASE_PLAINTEXT_ACK=private-network

# Generate these offline; never put plaintext passwords in this file.
AGENT_WORLD_OWNER_PASSWORD_HASH='scrypt-v1$32768$8$1$replace-salt$replace-digest'
AGENT_WORLD_CSRF_SECRET=replace-with-32-random-bytes-base64url
# Generate exactly 32 random bytes and encode them as unpadded base64url.
AGENT_WORLD_SECRET_MASTER_KEY=replace-with-32-random-bytes-base64url
AGENT_WORLD_SECRET_KEY_VERSION=1
AGENT_WORLD_LITELLM_MASTER_KEY=replace-with-32-random-bytes-base64url
AGENT_WORLD_LITELLM_SALT_KEY=replace-with-32-random-bytes-base64url

# Host Git root mounted read-write into the private Codex worker. The default
# is this repository. Use a dedicated root; symlink escapes and non-Git roots
# are rejected before the official SDK starts.
# AGENT_WORLD_CODEX_PROJECT_ROOT=C:/path/to/selected/repository
# AGENT_WORLD_CODEX_WORKER_ID=codex-worker-1
# Canonical Account created in Hub; the worker will activate only this exact ID.
# AGENT_WORLD_CODEX_ACCOUNT_ID=account_00000000-0000-0000-0000-000000000000
# AGENT_WORLD_CODEX_LEASE_MS=60000
# AGENT_WORLD_CODEX_POLL_MS=2000

# Optional until OpenClaw is configured. Use wss:// off-loopback.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=replace-me
# Use exactly one credential kind.
# OPENCLAW_GATEWAY_DEVICE_TOKEN=replace-me
# AGENT_WORLD_INSTANCE_ID=agent-world

# Native Plus Chat MCP remains fail-closed until all three values are set.
# The resource must be the exact public HTTPS endpoint and JWT audience.
# AGENT_WORLD_MCP_ENABLED=true
# AGENT_WORLD_MCP_RESOURCE=https://agent-world.example.com/api/mcp
# AGENT_WORLD_MCP_OAUTH_ISSUER=https://agent-world.example.com/oauth
# Enable the Compose profile only after generating both persistent files.
# The JWK file contains a private ES256 P-256 signing key; permissions should
# allow only the deployment owner to read it. Cookie keys is a JSON array of
# at least two independent 32-byte base64url values.
# AGENT_WORLD_MCP_AUTH_PROVIDER=local_oidc
# AGENT_WORLD_MCP_OAUTH_JWKS_FILE=C:/secure/agent-world-oauth-jwks.json
# AGENT_WORLD_MCP_OAUTH_COOKIE_KEYS_FILE=C:/secure/agent-world-oauth-cookie-keys.json
# Start with: docker compose --profile native-chat up -d
